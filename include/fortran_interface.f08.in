MODULE libheric_interface
   
   USE ISO_C_BINDING, ONLY: C_BOOL, C_CHAR, C_DOUBLE, C_INT, C_INT8_T, C_INT64_T, C_NULL_CHAR, C_LONG_LONG, C_PTR, C_F_POINTER
    
   IMPLICIT NONE
   INTEGER, PARAMETER :: LIBHERIC_MAX_AM = @MAX_AM@
   INTEGER, PARAMETER :: LIBHERIC_AM_LIMIT = 8
   INTEGER, PARAMETER :: LIBHERIC_FSTR_LEN = @FSTR_LEN@
   INTEGER, PARAMETER :: LIBHERIC_MAX_DEVICES_ON_NODE = @MAX_DEVICES_ON_NODE@
   INTEGER, PARAMETER, DIMENSION(0:LIBHERIC_AM_LIMIT) :: LIBHERIC_NCO = [ 1, 3, 6, 10, 15, 21, 28, 36, 45 ]
   INTEGER, PARAMETER, DIMENSION(0:LIBHERIC_AM_LIMIT) :: LIBHERIC_NSO = [ 1, 3, 5,  7,  9, 11, 13, 15, 17 ]

   INTEGER, PARAMETER :: LIBHERIC_POTENTIAL_OPERATOR_COULOMB = 1
   INTEGER, PARAMETER :: LIBHERIC_POTENTIAL_OPERATOR_SHORT_RANGE = 2

   TYPE acc_kind
       CHARACTER(kind=C_CHAR, len=LIBHERIC_FSTR_LEN) :: name
       CHARACTER(kind=C_CHAR, len=LIBHERIC_FSTR_LEN) :: type
       CHARACTER(kind=C_CHAR, len=LIBHERIC_FSTR_LEN) :: library
   END TYPE

   TYPE acc_device
       CHARACTER(kind=C_CHAR, len=LIBHERIC_FSTR_LEN) :: name
       CHARACTER(kind=C_CHAR, len=LIBHERIC_FSTR_LEN) :: bdf
       CHARACTER(kind=C_CHAR, len=LIBHERIC_FSTR_LEN) :: cpu_name
       INTEGER                                       :: num_cores
       TYPE(acc_kind)                                :: kind
   END TYPE

   TYPE atom_quartet_type
       INTEGER                                     :: quartet_id(4)
       REAL(C_DOUBLE), DIMENSION(:, :), POINTER    :: integrals
       INTEGER(C_INT8_T), DIMENSION(:, :), POINTER :: shellset_ids
   END TYPE

   PUBLIC :: LIBHERIC_MAX_AM, &
             LIBHERIC_FSTR_LEN, &
             LIBHERIC_MAX_DEVICES_ON_NODE, &
             acc_kind, &
             acc_device, &
             atom_quartet_type, &
             libheric_initialize, &
             libheric_release, &
             query_accelerator_devices, &
             create_accelerator_contexts, &
             free_accelerator_contexts, &
             accelerator_context_is_functional, &
             accelerator_context_set_potential_operator, &
             accelerator_context_set_quartet_class, &
             accelerator_context_set_atom_ids, &
             accelerator_context_set_B_offset, &
             accelerator_context_set_D_offset, &
             accelerator_context_set_Q_offset, &
             accelerator_context_set_set_ids, &
             accelerator_context_set_shell_ids, &
             accelerator_context_set_exponent_ids, &
             accelerator_context_submit_peri, &
             accelerator_context_get_next_staged_atom_quartet, &
             accelerator_context_prefetch_cached_atom_quartet, &
             accelerator_context_finish_quartet_class, &
             accelerator_context_update_positions, &
             accelerator_context_update_cell, &
             optimize_screening_function, &
             flush_logger, &
             generate_canonical_ids, &
             pc2_hide_acl

   INTERFACE
      LOGICAL(C_BOOL) FUNCTION libheric_initialize(mpi_rank) bind(C, name="libheric_initialize")
         IMPORT C_INT, C_BOOL
         INTEGER(C_INT), VALUE :: mpi_rank
      END FUNCTION libheric_initialize
      SUBROUTINE libheric_release() bind(C, name="libheric_release")
      END SUBROUTINE libheric_release
      SUBROUTINE get_accelerator_devices(packed_kinds, num_kinds, packed_devices, num_devices) &
          bind(C, name="get_accelerator_devices")
         IMPORT C_CHAR, C_INT
         CHARACTER(kind=C_CHAR) :: packed_kinds(*)
         INTEGER(C_INT), VALUE  :: num_kinds
         CHARACTER(kind=C_CHAR) :: packed_devices(*)
         INTEGER(C_INT)         :: num_devices
      END SUBROUTINE get_accelerator_devices
      SUBROUTINE alloc_accelerator_contexts(ctx_handles, &
                                            packed_device, &
                                            num_contexts, &
                                            mem_available, &
                                            compute_raw_cartesian, &
                                            raw_cell_mat, &
                                            raw_positions, raw_kinds,         num_positions, &
                                            raw_exponents,                    num_exponents, &
                                            raw_coefficients,                 num_coefficients, &
                                            raw_kind_nset, num_kinds, l_max, &
                                            raw_set_nexp, max_sets, &
                                            raw_set_nshl) &
                                            bind(C, name="alloc_accelerator_contexts")
         IMPORT C_BOOL, C_CHAR, C_INT, C_PTR, C_DOUBLE, C_LONG_LONG
         TYPE(C_PTR)                 :: ctx_handles
         CHARACTER(kind=C_CHAR)      :: packed_device(*)
         INTEGER(C_INT), VALUE       :: num_contexts
         INTEGER(C_LONG_LONG), VALUE :: mem_available 
         LOGICAL(C_BOOL), VALUE      :: compute_raw_cartesian
         REAL(C_DOUBLE)              :: raw_cell_mat
         REAL(C_DOUBLE)              :: raw_positions
         INTEGER(C_INT)              :: raw_kinds
         INTEGER(C_INT), VALUE       :: num_positions
         REAL(C_DOUBLE)              :: raw_exponents
         INTEGER(C_INT), VALUE       :: num_exponents
         REAL(C_DOUBLE)              :: raw_coefficients
         INTEGER(C_INT), VALUE       :: num_coefficients
         INTEGER(C_INT)              :: raw_kind_nset
         INTEGER(C_INT), VALUE       :: num_kinds
         INTEGER(C_INT), VALUE       :: l_max
         INTEGER(C_INT)              :: raw_set_nexp
         INTEGER(C_INT), VALUE       :: max_sets
         INTEGER(C_INT)              :: raw_set_nshl
      END SUBROUTINE
      SUBROUTINE free_accelerator_contexts(ctx_handles, num_contexts) bind(C, name="free_accelerator_contexts")
         IMPORT C_PTR, C_INT
         TYPE(C_PTR)           :: ctx_handles
         INTEGER(C_INT), VALUE :: num_contexts
      END SUBROUTINE
      LOGICAL(C_BOOL) FUNCTION accelerator_context_is_functional(ctx) bind(C, name="accelerator_context_is_functional")
         IMPORT C_PTR, C_BOOL
         TYPE(C_PTR), VALUE     :: ctx
      END FUNCTION
      SUBROUTINE accelerator_context_set_potential_operator(ctx, op_id, op_param) &
              bind(C, name="accelerator_context_set_potential_operator")
         IMPORT C_PTR, C_INT, C_DOUBLE
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT), VALUE  :: op_id
         REAL(C_DOUBLE), VALUE  :: op_param
      END SUBROUTINE
      SUBROUTINE accelerator_context_set_quartet_class(ctx, la, lb, lc, ld) bind(C, name="accelerator_context_set_quartet_class")
         IMPORT C_PTR, C_INT
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT), VALUE  :: la
         INTEGER(C_INT), VALUE  :: lb
         INTEGER(C_INT), VALUE  :: lc
         INTEGER(C_INT), VALUE  :: ld
      END SUBROUTINE
      SUBROUTINE accelerator_context_set_atom_ids(ctx, atom_a, atom_b, atom_c, atom_d) &
             bind(C, name="accelerator_context_set_atom_ids")
         IMPORT C_PTR, C_INT
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT), VALUE  :: atom_a, atom_b, atom_c, atom_d
      END SUBROUTINE
      SUBROUTINE accelerator_context_set_B_offset(ctx, off_x, off_y, off_z) bind(C, name="accelerator_context_set_B_offset")
         IMPORT C_PTR, C_INT
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT), VALUE  :: off_x
         INTEGER(C_INT), VALUE  :: off_y
         INTEGER(C_INT), VALUE  :: off_z
      END SUBROUTINE
      SUBROUTINE accelerator_context_set_D_offset(ctx, off_x, off_y, off_z) bind(C, name="accelerator_context_set_D_offset")
         IMPORT C_PTR, C_INT
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT), VALUE  :: off_x
         INTEGER(C_INT), VALUE  :: off_y
         INTEGER(C_INT), VALUE  :: off_z
      END SUBROUTINE
      SUBROUTINE accelerator_context_set_Q_offset(ctx, off_x, off_y, off_z) bind(C, name="accelerator_context_set_Q_offset")
         IMPORT C_PTR, C_INT
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT), VALUE  :: off_x
         INTEGER(C_INT), VALUE  :: off_y
         INTEGER(C_INT), VALUE  :: off_z
      END SUBROUTINE
      SUBROUTINE accelerator_context_set_set_ids(ctx, set_a, set_b, set_c, set_d, pmax) &
              bind(C, name="accelerator_context_set_set_ids")
         IMPORT C_PTR, C_INT, C_DOUBLE
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT), VALUE  :: set_a, set_b, set_c, set_d
         REAL(C_DOUBLE)         :: pmax 
      END SUBROUTINE
      SUBROUTINE accelerator_context_set_shell_ids(ctx, shl_a, shl_b, shl_c, shl_d) &
              bind(C, name="accelerator_context_set_shell_ids")
         IMPORT C_PTR, C_INT
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT), VALUE  :: shl_a, shl_b, shl_c, shl_d
      END SUBROUTINE
      SUBROUTINE accelerator_context_set_exponent_ids(ctx, exp_a, exp_b, exp_c, exp_d) &
              bind(C, name="accelerator_context_set_exponent_ids")
         IMPORT C_PTR, C_INT
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT), VALUE  :: exp_a, exp_b, exp_c, exp_d
      END SUBROUTINE
      SUBROUTINE accelerator_context_submit_peri(ctx) bind(C, name="accelerator_context_submit_peri")
         IMPORT C_PTR
         TYPE(C_PTR), VALUE     :: ctx
      END SUBROUTINE
      SUBROUTINE accelerator_context_finish_quartet_class(ctx) bind(C, name="accelerator_context_finish_quartet_class")
         IMPORT C_PTR
         TYPE(C_PTR), VALUE     :: ctx
      END SUBROUTINE
      LOGICAL(C_BOOL) FUNCTION internal_accelerator_context_get_next_staged_atom_quartet(ctx, quartet_id, integral_buffer, &
                                                                                         shellset_ids, n_shellset_quartets, &
                                                                                         eris_per_shellset_quartet) &
              bind(C, name="internal_accelerator_context_get_next_staged_atom_quartet")
         IMPORT C_PTR, C_BOOL, C_INT, C_INT64_T
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT)         :: quartet_id
         TYPE(C_PTR)            :: integral_buffer 
         TYPE(C_PTR)            :: shellset_ids
         INTEGER(C_INT64_T)     :: n_shellset_quartets
         INTEGER(C_INT64_T)     :: eris_per_shellset_quartet
      END FUNCTION
      LOGICAL(C_BOOL) FUNCTION accelerator_context_prefetch_cached_atom_quartet(ctx, A, B, C, D) &
              bind(C, name="accelerator_context_prefetch_cached_atom_quartet")
         IMPORT C_PTR, C_BOOL, C_INT
         TYPE(C_PTR), VALUE     :: ctx
         INTEGER(C_INT), VALUE  :: A, B, C, D
      END FUNCTION
      SUBROUTINE accelerator_context_update_positions(ctx, raw_positions, num_positions) & 
              bind(C, name="accelerator_context_update_positions")
         IMPORT C_PTR, C_INT, C_DOUBLE
         TYPE(C_PTR), VALUE    :: ctx
         REAL(C_DOUBLE)        :: raw_positions
         INTEGER(C_INT), VALUE :: num_positions
      END SUBROUTINE
      SUBROUTINE accelerator_context_update_cell(ctx, raw_cell_mat) & 
              bind(C, name="accelerator_context_update_cell")
         IMPORT C_PTR, C_INT, C_DOUBLE
         TYPE(C_PTR), VALUE    :: ctx
         REAL(C_DOUBLE)        :: raw_cell_mat
      END SUBROUTINE
      SUBROUTINE compute_single_quartet(op_id, op_param, la, lb, lc, ld, pos_A, pos_B, pos_C, pos_D, &
                                        alpha, beta, gamma, delta, quartet) &
              bind(C, name="compute_single_quartet")
         IMPORT C_INT, C_DOUBLE
         INTEGER(C_INT), VALUE :: op_id
         REAL(C_DOUBLE), VALUE :: op_param
         INTEGER(C_INT), VALUE :: la, lb, lc, ld
         REAL(C_DOUBLE)        :: pos_A, pos_B, pos_C, pos_D
         REAL(C_DOUBLE), VALUE :: alpha, beta, gamma, delta
         REAL(C_DOUBLE)        :: quartet
      END SUBROUTINE
      SUBROUTINE optimize_screening_function(x_data, y_data, n_data, y_cutoff, model, n_model) &
              bind(C, name="optimize_screening_function")
         IMPORT C_DOUBLE, C_INT
         REAL(C_DOUBLE)         :: x_data
         REAL(C_DOUBLE)         :: y_data
         INTEGER(C_INT)         :: n_data
         REAL(C_DOUBLE), VALUE  :: y_cutoff
         REAL(C_DOUBLE)         :: model
         INTEGER(C_INT), VALUE  :: n_model
      END SUBROUTINE
      SUBROUTINE flush_logger() bind(C, name="flush_logger")
      END SUBROUTINE
      SUBROUTINE pc2_hide_acl() bind(C, name="pc2_hide_acl")
      END SUBROUTINE 
   END INTERFACE

CONTAINS
    SUBROUTINE pack_kinds(kinds, packed_kinds)
        TYPE(acc_kind), DIMENSION(:), INTENT(IN)                :: kinds
        CHARACTER(kind=C_CHAR, len=:), ALLOCATABLE, INTENT(OUT) :: packed_kinds
        INTEGER                                                 :: num_kinds, i, name_off, type_off, lib_off
        
        num_kinds = SIZE(kinds)
        packed_kinds = REPEAT(" ", num_kinds * LIBHERIC_FSTR_LEN * 3)
        DO i = 1, num_kinds
            name_off = ((i - 1) * 3 + 0) * LIBHERIC_FSTR_LEN + 1
            type_off = ((i - 1) * 3 + 1) * LIBHERIC_FSTR_LEN + 1
            lib_off  = ((i - 1) * 3 + 2) * LIBHERIC_FSTR_LEN + 1
            packed_kinds(name_off:name_off + LEN_TRIM(kinds(i)%name)    + 1) = TRIM(kinds(i)%name) // C_NULL_CHAR
            packed_kinds(type_off:type_off + LEN_TRIM(kinds(i)%type)    + 1) = TRIM(kinds(i)%type) // C_NULL_CHAR
            packed_kinds(lib_off :lib_off  + LEN_TRIM(kinds(i)%library) + 1) = TRIM(kinds(i)%library) // C_NULL_CHAR 
        END DO
    END SUBROUTINE

    SUBROUTINE pack_devices(devices, packed_devices)
        TYPE(acc_device), DIMENSION(:), INTENT(IN)              :: devices
        CHARACTER(kind=C_CHAR, len=:), ALLOCATABLE, INTENT(OUT) :: packed_devices
        INTEGER                                                 :: i, dev_name_off, dev_bdf_off, dev_cpu_off, &
                                                                   dev_cores_off, kind_name_off, kind_type_off, &
                                                                   kind_lib_off, num_devices
        CHARACTER(kind=C_CHAR, len=10)                          :: num_cores_str
        num_devices = SIZE(devices)
        packed_devices = REPEAT(" ", num_devices * LIBHERIC_FSTR_LEN * 7)
        DO i = 1, num_devices
            dev_name_off  = ((i - 1) * 7 + 0) * LIBHERIC_FSTR_LEN + 1
            dev_bdf_off   = ((i - 1) * 7 + 1) * LIBHERIC_FSTR_LEN + 1
            dev_cpu_off   = ((i - 1) * 7 + 2) * LIBHERIC_FSTR_LEN + 1
            dev_cores_off = ((i - 1) * 7 + 3) * LIBHERIC_FSTR_LEN + 1
            kind_name_off = ((i - 1) * 7 + 4) * LIBHERIC_FSTR_LEN + 1
            kind_type_off = ((i - 1) * 7 + 5) * LIBHERIC_FSTR_LEN + 1
            kind_lib_off  = ((i - 1) * 7 + 6) * LIBHERIC_FSTR_LEN + 1

            WRITE(num_cores_str, "(I10)") devices(i)%num_cores

            packed_devices(dev_name_off  :dev_name_off  + LEN_TRIM(devices(i)%name)         + 1) & 
                = TRIM(devices(i)%name) // C_NULL_CHAR                                        
            packed_devices(dev_bdf_off   :dev_bdf_off   + LEN_TRIM(devices(i)%bdf)          + 1) & 
                = TRIM(devices(i)%bdf) // C_NULL_CHAR                                         
            packed_devices(dev_cpu_off   :dev_cpu_off   + LEN_TRIM(devices(i)%cpu_name)     + 1) & 
                = TRIM(devices(i)%cpu_name) // C_NULL_CHAR
            packed_devices(dev_cores_off :dev_cores_off + LEN(ADJUSTL(num_cores_str))       + 1) & 
                = ADJUSTL(num_cores_str) // C_NULL_CHAR
            packed_devices(kind_name_off :kind_name_off + LEN_TRIM(devices(i)%kind%name)    + 1) & 
                = TRIM(devices(i)%kind%name) // C_NULL_CHAR
            packed_devices(kind_type_off :kind_type_off + LEN_TRIM(devices(i)%kind%type)    + 1) & 
                = TRIM(devices(i)%kind%type) // C_NULL_CHAR
            packed_devices(kind_lib_off  :kind_lib_off  + LEN_TRIM(devices(i)%kind%library) + 1) & 
                = TRIM(devices(i)%kind%library) // C_NULL_CHAR
        END DO

    END SUBROUTINE

    SUBROUTINE unpack_devices(packed_devices, num_devices, devices)
        CHARACTER(kind=C_CHAR, len=:), ALLOCATABLE, INTENT(IN)   :: packed_devices
        INTEGER                                                  :: num_devices
        TYPE(acc_device), DIMENSION(:), ALLOCATABLE, INTENT(OUT) :: devices
        INTEGER                                                  :: i, dev_name_off, dev_bdf_off, dev_cpu_off, &
                                                                    dev_cores_off, kind_name_off, kind_type_off, &
                                                                    kind_lib_off
        CHARACTER(kind=C_CHAR, len=:), ALLOCATABLE               :: read_cores
        
        ALLOCATE(devices(num_devices))

        DO i = 1, num_devices
            dev_name_off  = ((i - 1) * 7 + 0) * LIBHERIC_FSTR_LEN + 1
            dev_bdf_off   = ((i - 1) * 7 + 1) * LIBHERIC_FSTR_LEN + 1
            dev_cpu_off   = ((i - 1) * 7 + 2) * LIBHERIC_FSTR_LEN + 1
            dev_cores_off = ((i - 1) * 7 + 3) * LIBHERIC_FSTR_LEN + 1
            kind_name_off = ((i - 1) * 7 + 4) * LIBHERIC_FSTR_LEN + 1
            kind_type_off = ((i - 1) * 7 + 5) * LIBHERIC_FSTR_LEN + 1
            kind_lib_off  = ((i - 1) * 7 + 6) * LIBHERIC_FSTR_LEN + 1

            devices(i)%name = TRIM(packed_devices(dev_name_off:dev_name_off + LIBHERIC_FSTR_LEN - 1))
            devices(i)%bdf  = TRIM(packed_devices(dev_bdf_off :dev_bdf_off  + LIBHERIC_FSTR_LEN - 1))
            devices(i)%cpu_name =TRIM(packed_devices(dev_cpu_off :dev_cpu_off  + LIBHERIC_FSTR_LEN - 1)) 
            read_cores = TRIM(packed_devices(dev_cores_off :dev_cores_off + LIBHERIC_FSTR_LEN - 1))
            READ(read_cores, *) devices(i)%num_cores
            devices(i)%kind%name    = TRIM(packed_devices(kind_name_off:kind_name_off + LIBHERIC_FSTR_LEN - 1))
            devices(i)%kind%type    = TRIM(packed_devices(kind_type_off:kind_type_off + LIBHERIC_FSTR_LEN - 1))
            devices(i)%kind%library = TRIM(packed_devices(kind_lib_off :kind_lib_off  + LIBHERIC_FSTR_LEN - 1))
        END DO
    END SUBROUTINE

    SUBROUTINE query_accelerator_devices(kinds, devices)
        TYPE(acc_kind), DIMENSION(:), INTENT(IN)                 :: kinds
        TYPE(acc_device), DIMENSION(:), ALLOCATABLE, INTENT(OUT) :: devices
        
        INTEGER                                              :: num_kinds, num_devices
        CHARACTER(kind=C_CHAR, len=:), ALLOCATABLE           :: packed_kinds
        CHARACTER(kind=C_CHAR, len=:), ALLOCATABLE           :: packed_devices
        
        num_kinds = SIZE(kinds)
        CALL pack_kinds(kinds, packed_kinds)
        
        packed_devices = REPEAT(" ", LIBHERIC_MAX_DEVICES_ON_NODE * LIBHERIC_FSTR_LEN * 7)

        CALL get_accelerator_devices(packed_kinds, num_kinds, & 
                                     packed_devices, num_devices)
        

        IF (num_devices > LIBHERIC_MAX_DEVICES_ON_NODE) THEN
            WRITE(*, "('[WARNING] libheric discovered ',I3,' devices, but only ',I2,'were stored!')") &
                num_devices, LIBHERIC_MAX_DEVICES_ON_NODE
        END IF

        CALL unpack_devices(packed_devices, MIN(num_devices, LIBHERIC_MAX_DEVICES_ON_NODE), devices)     

    END SUBROUTINE

    SUBROUTINE create_accelerator_contexts(ctx_handles, dev, &
                                           num_contexts, &
                                           mem_available, &
                                           compute_raw_cartesian, &
                                           cell_mat, &
                                           positions, kinds,         &
                                           exponents,                &
                                           coefficients,             &
                                           kind_nset, &
                                           set_nexp,   &
                                           set_nshl) 
        TYPE(C_PTR), INTENT(INOUT)                                              :: ctx_handles
        TYPE(acc_device), INTENT(IN)                                            :: dev
        INTEGER(C_INT),                                             INTENT(IN)  :: num_contexts
        INTEGER(C_LONG_LONG),                                       INTENT(IN)  :: mem_available
        LOGICAL(C_BOOL),                                            INTENT(IN)  :: compute_raw_cartesian
        REAL(C_DOUBLE), DIMENSION(3, 3),                            INTENT(IN)  :: cell_mat
        REAL(C_DOUBLE), DIMENSION(:, :),                CONTIGUOUS, INTENT(IN)  :: positions
        INTEGER(C_INT), DIMENSION(:),                   CONTIGUOUS, INTENT(IN)  :: kinds
        REAL(C_DOUBLE), DIMENSION(:),                   CONTIGUOUS, INTENT(IN)  :: exponents    
        REAL(C_DOUBLE), DIMENSION(:),                   CONTIGUOUS, INTENT(IN)  :: coefficients
        INTEGER(C_INT), DIMENSION(:, :),                CONTIGUOUS, INTENT(IN)  :: kind_nset
        INTEGER(C_INT), DIMENSION(:, :, :),             CONTIGUOUS, INTENT(IN)  :: set_nexp 
        INTEGER(C_INT), DIMENSION(:, :, :),             CONTIGUOUS, INTENT(IN)  :: set_nshl

        CHARACTER(kind=C_CHAR, len=:), ALLOCATABLE  :: packed_device

        CALL pack_devices([dev], packed_device)
        CALL alloc_accelerator_contexts(ctx_handles, &
                                        packed_device, &
                                        num_contexts, &
                                        mem_available, &
                                        compute_raw_cartesian, &
                                        cell_mat(1, 1), &
                                        positions(1, 1), kinds(1), SIZE(positions, 2), &
                                        exponents(1), SIZE(exponents, 1), &
                                        coefficients(1), SIZE(coefficients, 1), & 
                                        kind_nset(1, 1), SIZE(kind_nset, 1), SIZE(kind_nset, 2) - 1, &
                                        set_nexp(1, 1, 1), SIZE(set_nexp, 1), &
                                        set_nshl(1, 1, 1))

    END SUBROUTINE
    
    LOGICAL FUNCTION is_canonical(i, j, k, l)
       INTEGER, INTENT(IN) :: i, j, k, l
       is_canonical = (i .GE. j) .AND. (k .GE. l) .AND. &
                      ((i + j .GE. k + l) .AND. ((i + j .NE. k + l) .OR. (i .LE. k))) 
    END FUNCTION

    SUBROUTINE generate_canonical_ids(l_max, canonical_idx, canonical_idx_inverse, n_canonical)
        INTEGER,                                     INTENT(IN)  :: l_max
        INTEGER, ALLOCATABLE, DIMENSION(:, :, :, :), INTENT(OUT) :: canonical_idx
        INTEGER, ALLOCATABLE, DIMENSION(:, :),       INTENT(OUT) :: canonical_idx_inverse
        INTEGER,                                     INTENT(OUT) :: n_canonical

        n_canonical = LIBHERIC_NCO(l_max) * (LIBHERIC_NCO(l_max) + 1) / 2
        ALLOCATE(canonical_idx(0:l_max, 0:l_max, 0:l_max, 0:l_max))
        ALLOCATE(canonical_idx_inverse(n_canonical, 4))
      
        canonical_idx = -1
        canonical_idx_inverse = -1
        init_canonical_idx: BLOCK
        INTEGER :: i, j, k, l, ctr
        ctr = 0
        DO i = 0, l_max
           DO j = 0, l_max
              DO k = 0, l_max
                 DO l = 0, l_max
                    IF (is_canonical(i, j, k, l) .EQV. .TRUE.) THEN
                       ctr = ctr + 1
                       canonical_idx(i, j, k, l) = ctr
                       canonical_idx(j, i, k, l) = ctr
                       canonical_idx(i, j, l, k) = ctr
                       canonical_idx(j, i, l, k) = ctr
                       canonical_idx(k, l, i, j) = ctr
                       canonical_idx(l, k, i, j) = ctr
                       canonical_idx(k, l, j, i) = ctr
                       canonical_idx(l, k, j, i) = ctr

                       canonical_idx_inverse(ctr, :) = (/i, j, k, l/)
                    END IF
                 END DO
              END DO
           END DO
        END DO
        END BLOCK init_canonical_idx
    END SUBROUTINE

    LOGICAL(C_BOOL) FUNCTION accelerator_context_get_next_staged_atom_quartet(ctx, atom_quartet) RESULT(quartet_available)
        TYPE(C_PTR), VALUE                   :: ctx 
        TYPE(atom_quartet_type), INTENT(OUT) :: atom_quartet

        TYPE(C_PTR)                          :: tmp_integral_buffer, tmp_shellset_ids
        INTEGER(C_INT64_T)                   :: n_shellset_quartets, eris_allocated_per_shellset 

        quartet_available = internal_accelerator_context_get_next_staged_atom_quartet(ctx, atom_quartet%quartet_id(1), &
                                                                                      tmp_integral_buffer, tmp_shellset_ids, &
                                                                                      n_shellset_quartets, &
                                                                                      eris_allocated_per_shellset)
        IF(quartet_available) THEN
           CALL C_F_POINTER(tmp_integral_buffer, atom_quartet%integrals,    [eris_allocated_per_shellset, n_shellset_quartets])
           CALL C_F_POINTER(tmp_shellset_ids,    atom_quartet%shellset_ids, [INT(8, kind=C_INT64_T), n_shellset_quartets])
        END IF
    END FUNCTION 

END MODULE libheric_interface
